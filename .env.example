# Mode du catalogue et du panier : "demo" (data/products.json + panier local) ou "shopify"
NEXT_PUBLIC_COMMERCE_MODE=demo

# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemple-goggles.fr

# --- Shopify Storefront API (mode "shopify" uniquement) ---
# Domaine .myshopify.com de la boutique, sans https://
SHOPIFY_STORE_DOMAIN=ma-boutique.myshopify.com
# Jeton Storefront API (application "Headless" ou app personnalisée)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
