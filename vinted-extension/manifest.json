{
  "manifest_version": 3,
  "name": "Vinted Dressing Assistant",
  "version": "0.1.0",
  "description": "Gestion de dressing Vinted : republication planifiée, messages aux favoris, tableau de bord. Mode simulation par défaut.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.be/*",
    "https://www.vinted.lu/*",
    "https://www.vinted.es/*",
    "https://www.vinted.it/*",
    "https://www.vinted.de/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.at/*",
    "https://www.vinted.co.uk/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Vinted Dressing Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.es/*",
        "https://www.vinted.it/*",
        "https://www.vinted.de/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.at/*",
        "https://www.vinted.co.uk/*"
      ],
      "js": [
        "src/content/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
